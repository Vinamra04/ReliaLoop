# ReliaLoop configuration. Copy to .env with `python -m tools.cli init`
# (or `make init`), which also replaces every __GENERATE__ value with a
# random token. Never commit .env. Every variable is documented in
# docs/configuration.md.

PROJECT_NAME=relialoop
LOG_LEVEL=INFO

# --- Secrets generated by init (random, per machine) -----------------------
WEBHOOK_TOKEN=__GENERATE__
APPROVER_TOKEN=__GENERATE__
CHAOS_TOKEN=__GENERATE__
LOADGEN_TOKEN=__GENERATE__
CONSOLE_OPERATOR_KEY=__GENERATE__
POSTGRES_PASSWORD=__GENERATE__
GRAFANA_ADMIN_PASSWORD=__GENERATE__

# --- LLM (optional). Paste the key into .env yourself; never into this file --
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Pin a model (recommended). Empty = probe the newest flash-class model at first
# use, which itself spends requests from a small free-tier quota (see ADR 0003).
GEMINI_MODEL=

# --- Agent -----------------------------------------------------------------
# observe | dry_run | enforce. dry_run is the safe default.
AGENT_MODE=dry_run
# rules | llm
DIAGNOSIS_MODE=rules
AGENT_WORKERS=2

# --- Demo services ---------------------------------------------------------
POSTGRES_USER=relialoop
POSTGRES_DB=orders
ORDERS_WORKERS=4
ORDERS_WORK_MS=40
LOADGEN_RPS=20

# --- Deploy gate -----------------------------------------------------------
GATE_MIN_BUDGET=0.25

# --- Host ports (all bound to 127.0.0.1). Change one if it is already in use
GATEWAY_PORT=8000
LOADGEN_PORT=8002
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
AGENT_PORT=8080
GRAFANA_PORT=3000

# Group that owns /var/run/docker.sock as seen inside containers.
# Docker Desktop: 0. Linux: the gid of the docker group (getent group docker).
DOCKER_GID=0
